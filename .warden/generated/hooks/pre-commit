# Warden never blocks a commit. It reports and exits 0.
if ! command -v warden >/dev/null 2>&1; then
  echo "Warden did not check this commit: the global warden command is not on PATH. Next action: run npm install -g git+https://github.com/RyanAmundson/warden.git#v0.1.19." >&2
  exit 0
fi
WARDEN_GIT_PID=$PPID warden check --base 'main' --trigger git-commit || echo "Warden's commit check exited $?. Warden never blocks a commit, so the commit continues." >&2
exit 0
