{
  "name": "warden",
  "version": "0.1.20",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build:dist": "tsc",
    "test": "tsc && vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "12.1.0",
    "entities": "9.0.0",
    "eslint": "9.39.5",
    "github-slugger": "2.0.0",
    "marked": "18.0.14",
    "parse5": "8.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "vitest": "4.1.12"
  },
  "bin": {
    "warden": "bin/warden.js"
  },
  "files": [
    "bin",
    "dist/src",
    "dist/eslint-plugin",
    "dist/schema",
    "packs",
