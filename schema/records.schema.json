{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "records",
  "$defs": {
    "tierBudgetMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edit", "commit", "boundary"],
      "properties": {
        "edit": { "type": "integer", "minimum": 1 },
        "commit": { "type": "integer", "minimum": 1 },
        "boundary": { "type": "integer", "minimum": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warden", "project", "base", "packs", "tierBudgetMs", "loopBreakerRepeats"],
      "properties": {
        "warden": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "base": { "type": "string", "minLength": 1 },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "paths"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "paths": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tierBudgetMs": { "$ref": "#/$defs/tierBudgetMs" },
        "loopBreakerRepeats": { "type": "integer", "minimum": 1 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition", "bans"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "bans": { "type": "array", "items": { "type": "string" } }
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "runs", "budgetMs", "version", "implementation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["lint", "type", "model", "runtime", "review", "instruction", "legacy"] },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["edit", "commit", "boundary"] }
        },
        "budgetMs": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "options": {},
        "mustFail": { "type": "string", "minLength": 1 },
        "mustPass": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "not": { "const": "legacy" } } } },
      "then": { "required": ["mustFail", "mustPass"] }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "terms", "paths", "conflictsWith", "guardrails"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "terms": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "conflictsWith": { "type": "array", "items": { "type": "string" } },
        "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrail" } }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "terms", "practices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layer": { "type": "integer", "minimum": 0 },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } },
        "practices": { "type": "array", "items": { "$ref": "#/$defs/practice" } }
      }
    }
  }
}
