{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "records",
    "$defs": {
        "tierBudgetMs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["edit", "commit", "boundary"],
            "properties": {
                "edit": { "type": "integer", "minimum": 1 },
                "commit": { "type": "integer", "minimum": 1 },
                "boundary": { "type": "integer", "minimum": 1 }
            }
        },
        "config": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "base", "packs", "tierBudgetMs", "loopBreakerRepeats"],
            "properties": {
                "warden": { "type": "string", "minLength": 1 },
                "project": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "base": { "type": "string", "minLength": 1 },
                "packs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "paths"],
                        "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "paths": { "type": "array", "items": { "type": "string" } },
                            "settings": { "type": "object" }
                        }
                    }
                },
                "unitKinds": {
                    "type": "object",
                    "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
                    "additionalProperties": { "$ref": "#/$defs/unitKind" }
                },
                "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
                "tierBudgetMs": { "$ref": "#/$defs/tierBudgetMs" },
                "loopBreakerRepeats": { "type": "integer", "minimum": 1 },
                "bench": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "baseFiles": { "type": "integer", "minimum": 1 },
                        "maxFiles": { "type": "integer", "minimum": 1 },
                        "minMarginalMs": { "type": "number", "exclusiveMinimum": 0 },
                        "linearMax": { "type": "number", "exclusiveMinimum": 0 },
                        "sublinearMax": { "type": "number", "exclusiveMinimum": 0 },
                        "constantMs": { "type": "number", "exclusiveMinimum": 0 }
                    }
                }
            }
        },
        "unitKind": {
            "type": "object",
            "required": ["document", "sections"],
            "additionalProperties": false,
            "properties": {
                "document": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*\\.md$" },
                "layout": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "sections": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[^#\\s](?:[^\\r\\n]*[^#\\s])?$" }
                }
            }
        },
        "unit": {
            "type": "object",
            "required": ["id", "kind", "folder"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "folder": { "type": "string", "minLength": 1 },
                "term": { "type": "string", "minLength": 1 },
                "publicEntry": { "type": "string", "minLength": 1 }
            }
        },
        "term": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "definition", "bans"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "definition": { "type": "string", "minLength": 1 },
                "bans": { "type": "array", "items": { "type": "string" } }
            }
        },
        "example": {
            "anyOf": [
                { "type": "string", "minLength": 1 },
                {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": { "minLength": 1, "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))" },
                    "additionalProperties": { "type": "string" }
                }
            ]
        },
        "guardrail": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "runs", "budgetMs", "version", "implementation", "mustFail", "mustPass"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["lint", "type", "model", "runtime", "review", "instruction", "legacy"] },
                "runs": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "enum": ["edit", "commit", "boundary"] }
                },
                "budgetMs": { "type": "integer", "minimum": 1 },
                "version": { "type": "integer", "minimum": 1 },
                "implementation": { "type": "string", "minLength": 1 },
                "options": {},
                "scope": { "const": "project" },
                "unitExample": {
                    "type": "object", "additionalProperties": false, "required": ["folder", "kind"],
                    "properties": {
                        "folder": { "type": "string", "minLength": 1 },
                        "publicEntry": { "type": "string", "minLength": 1 },
                        "kind": { "$ref": "#/$defs/unitKind" }
                    }
                },
                "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "mustFail": { "$ref": "#/$defs/example" },
                "mustPass": { "$ref": "#/$defs/example" }
            },
            "if": { "properties": { "kind": { "not": { "const": "instruction" } } } },
            "then": { "properties": { "implementation": { "type": "string", "pattern": "^[^:]+:.+" } } }
        },
        "practice": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "terms", "paths", "conflictsWith", "guardrails"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "statement": { "type": "string", "minLength": 1 },
                "terms": { "type": "array", "items": { "type": "string" } },
                "paths": { "type": "array", "items": { "type": "string" } },
                "conflictsWith": { "type": "array", "items": { "type": "string" } },
                "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrail" } }
            }
        },
        "capability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "serves", "purpose", "when", "upholds", "commands", "replaces"],
            "if": { "properties": { "kind": { "const": "skill" } } },
            "then": { "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } } },
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["skill", "tool"] },
                "serves": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string", "minLength": 1 },
                "when": { "type": "string", "minLength": 1 },
                "upholds": { "type": "array", "items": { "type": "string" } },
                "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "replaces": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            { "type": "string" },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["command"],
                                "properties": {
                                    "command": { "type": "string", "pattern": "^[ \\t]*[./]*[a-zA-Z0-9_][a-zA-Z0-9_./-]*(?:[ \\t]+[-a-zA-Z0-9_./:=@+,]+)*[ \\t]*(?![\\s\\S])" }
                                }
                            }
                        ]
                    }
                },
                "review": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["adapter", "model"],
                    "properties": {
                        "adapter": { "type": "string", "minLength": 1 },
                        "model": { "type": "string", "minLength": 1 },
                        "roundLimit": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                    }
                }
            }
        },
        "pack": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "layer", "terms", "practices"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "layer": { "type": "integer", "minimum": 0 },
                "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } },
                "practices": { "type": "array", "items": { "$ref": "#/$defs/practice" } },
                "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
                "settings": { "type": "object" }
            }
        }
    }
}
